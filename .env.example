# Copy this file to .env for local development.
# Do not commit .env.

SPRING_PROFILES_ACTIVE=dev

DEV_DB_USERNAME=root
DEV_DB_PASSWORD=root
DEV_LEGACY_DB_USERNAME=root
DEV_LEGACY_DB_PASSWORD=root
DEV_AUTHENTICATION_DB_USERNAME=root
DEV_AUTHENTICATION_DB_PASSWORD=root

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

MAIL_PASSWORD=your-first-mail-app-password
MAIL_PASSWORD_2=your-second-mail-app-password

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost:4200
